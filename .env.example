# Meta Marketing API credentials
META_ACCESS_TOKEN=your_system_user_token_here

# Default ad account, used when a tool call omits `account`
META_AD_ACCOUNT_ID=123456789

# Optional: extra units, as label:account_id pairs separated by commas.
# Any tool then accepts account="<label>" (or a raw account ID).
META_AD_ACCOUNTS=unit_one:123456789,unit_two:987654321

# Optional per-unit token, for a unit whose account sits in a Business Manager
# the main token cannot reach. Named META_TOKEN_<LABEL>, uppercased.
# Units without one fall back to META_ACCESS_TOKEN.
META_TOKEN_UNIT_TWO=system_user_token_of_that_other_business

# Optional: protect the MCP endpoint with an API key
MCP_API_KEY=

# Server port (Railway sets this automatically)
PORT=3000
